{
  "name": "react-canvas-label-editor",
  "version": "19.0.0",
  "description": "React class component for editing 1-bit canvas label templates, with a WebAssembly label rasterizer",
  "type": "module",
  "files": [
    "dist",
    "src/server",
    "src/utils",
    "src/render",
    "src/components/CanvasEditor/constants.js",
    "src/fonts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "browser": "./dist/client.js",
      "node": "./dist/node.js",
      "default": "./dist/client.js"
    },
    "./style.css": "./dist/client.css"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.js",
    "build": "node scripts/build-lib.mjs",
    "prepare": "npm run build",
    "lint": "oxlint",
    "preview": "vite preview --config vite.dev.config.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "canvaskit-wasm": "^0.42.0",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
